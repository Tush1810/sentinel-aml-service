    {
      "name": "02 - Create a customer (PEP, KYC pending)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/v1/customers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "customers"
          ]
        },
        "description": "Creates a customer and an opening account. Politically exposed adds +15 to every alert this customer later raises, and unverified KYC adds a further +10, so the same transaction scores higher for them than for an ordinary customer.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{adminUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{adminPassword}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Meera\",\n  \"lastName\": \"Iyer\",\n  \"politicallyExposed\": true,\n  \"kycVerified\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('customerRef', body.customerRef);",
              "pm.collectionVariables.set('accountRef', body.accountRef);",
              "pm.test('created HIGH risk', () => pm.expect(body.riskRating).to.eql('HIGH'));",
              "pm.test('KYC pending', () => pm.expect(body.kycStatus).to.eql('PENDING'));"
            ]
          }
        }
      ]
    },
