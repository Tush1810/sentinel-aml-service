          "raw": "{{baseUrl}}/api/v1/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "transactions"
          ]
        },
        "description": "A fourth deposit in the same pattern returns the SAME alertRef with evidence grown 3 -> 4. One pattern, one alert - this is what stops a customer generating 50 redundant alerts.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"txnRef\": \"DEMO_4_{{runId}}\",\n  \"accountRef\": \"ACC_000001\",\n  \"direction\": \"CREDIT\",\n  \"txnType\": \"CASH_DEPOSIT\",\n  \"amount\": 9900,\n  \"currency\": \"INR\",\n  \"counterpartyCountry\": \"IN\",\n  \"channel\": \"BRANCH\",\n  \"txnTimestamp\": \"{{demoDate}}T14:00:00Z\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
