{
  "info": {
    "name": "Sentinel AML - Demo Walkthrough",
    "description": "Run top to bottom. Steps 04-07 build a structuring pattern; 06 is where the first alert fires. alertRef and caseRef are captured automatically by test scripts, so the case steps need no copy-paste.\n\nUsers: analyst/analyst (read only), admin/admin (ingest + unmasked PII).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "analystUser",
      "value": "analyst"
    },
    {
      "key": "analystPassword",
      "value": "analyst"
    },
    {
      "key": "adminUser",
      "value": "admin"
    },
    {
      "key": "adminPassword",
      "value": "admin"
    },
    {
      "key": "alertRef",
      "value": ""
    },
    {
      "key": "caseRef",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "demoDate",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Dashboard summary (baseline)",
      "request": {
        "method": "GET",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{analystUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{analystPassword}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/dashboard/summary",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "dashboard",
            "summary"
          ]
        },
        "description": "Starting state. Note the alert count so the change after step 06 is obvious.",
        "header": []
      }
    },
    {
      "name": "02 - Bulk load customers (CSV)",
      "request": {
