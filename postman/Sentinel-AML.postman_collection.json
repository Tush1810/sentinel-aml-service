        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"txnRef\": \"PM-{{runId}}-CLEAN\",\n  \"accountRef\": \"{{accountRef}}\",\n  \"direction\": \"CREDIT\",\n  \"txnType\": \"CASH_DEPOSIT\",\n  \"amount\": 500,\n  \"currency\": \"INR\",\n  \"counterpartyName\": \"Counterparty\",\n  \"counterpartyCountry\": \"IN\",\n  \"channel\": \"ONLINE\",\n  \"description\": \"Postman walkthrough\",\n  \"txnTimestamp\": \"{{now}}\"\n}",
          "options": {
