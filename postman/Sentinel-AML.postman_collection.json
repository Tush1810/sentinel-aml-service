              "value": "{{analystPassword}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"disposition\": \"ESCALATED_TO_SAR\",\n  \"reason\": \"Structuring pattern on a politically exposed customer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
