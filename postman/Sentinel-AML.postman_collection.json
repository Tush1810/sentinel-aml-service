        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "/Users/tusharpruthi/Downloads/BlrAzenioJavahackathon/accounts.csv"
            }
          ]
