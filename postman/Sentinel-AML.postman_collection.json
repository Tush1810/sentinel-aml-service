    {
      "name": "11 - Alert queue as ANALYST (names masked)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/alerts?size=100",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "alerts"
          ],
          "query": [
            {
              "key": "size",
              "value": "100"
            }
          ]
        },
        "description": "Highest risk first. Customer names are masked to a first name and a surname initial. Detection is asynchronous, so if the alerts from the steps above are missing, the engine has not consumed their change events yet. Wait a second and send again.",
        "header": [],
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{analystUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{analystPassword}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Detection is asynchronous. Pause so the change event can reach the engine",
              "// before the queue is read. Postman has no sleep, hence the wait loop.",
              "const until = Date.now() + 1500;",
              "while (Date.now() < until) { /* wait */ }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "const mine = body.filter(a => a.customerRef === pm.collectionVariables.get('customerRef'));",
              "const tries = Number(pm.collectionVariables.get('alertTries') || 0);",
              "",
              "// The engine may not have caught up. Re-send this request rather than failing.",
              "if (mine.length === 0 && tries < 8) {",
              "  pm.collectionVariables.set('alertTries', tries + 1);",
              "  console.log(`no alerts yet, retry ${tries + 1} of 8`);",
              "  postman.setNextRequest('11 - Alert queue as ANALYST (names masked)');",
              "} else {",
              "  pm.collectionVariables.set('alertTries', 0);",
              "  if (mine.length) { pm.collectionVariables.set('alertRef', mine[0].alertRef); }",
              "  console.log('alerts for this customer:', mine.map(a => `${a.ruleCode} ${a.riskScore}`).join(', '));",
              "  pm.test('names are masked', () => mine.forEach(a =>",
              "    pm.expect(a.customerName).to.match(/^\\S+ \\S\\.$|^\\S+$/)));",
              "  pm.test('the engine raised alerts for this customer',",
              "    () => pm.expect(mine.length).to.be.above(0));",
              "}"
            ]
          }
        }
      ]
    },
