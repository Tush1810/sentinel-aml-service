  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Every run needs its own calendar day, not just its own references. Deposits from an",
          "// earlier run sitting in the same 24h window complete the structuring pattern before",
          "// the demo starts, so the first deposit would already fire.",
          "if (!pm.collectionVariables.get('runId')) {",
          "    const runId = Date.now().toString().slice(-6);",
          "    pm.collectionVariables.set('runId', runId);",
          "    const offsetDays = 30 + (parseInt(runId, 10) % 900);",
          "    const day = new Date(Date.now() + offsetDays * 86400000);",
          "    pm.collectionVariables.set('demoDate', day.toISOString().slice(0, 10));",
          "}"
        ]
      }
    }
  ]
