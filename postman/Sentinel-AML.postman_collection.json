            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"txnRef\": \"DEMO_2_{{runId}}\",\n  \"accountRef\": \"ACC_000001\",\n  \"direction\": \"CREDIT\",\n  \"txnType\": \"CASH_DEPOSIT\",\n  \"amount\": 9700,\n  \"currency\": \"INR\",\n  \"counterpartyCountry\": \"IN\",\n  \"channel\": \"BRANCH\",\n  \"txnTimestamp\": \"{{demoDate}}T09:00:00Z\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "06 - Deposit 3 of 3 -> STRUCTURING fires",
      "request": {
        "method": "POST",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{adminUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{adminPassword}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "transactions"
          ]
        },
        "description": "THE MONEY SHOT. The third deposit completes the pattern and the alert comes back inline with risk score, evidence transaction ids and a plain-English explanation.\n\nSaves alertRef to a collection variable for the case steps.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"txnRef\": \"DEMO_3_{{runId}}\",\n  \"accountRef\": \"ACC_000001\",\n  \"direction\": \"CREDIT\",\n  \"txnType\": \"CASH_DEPOSIT\",\n  \"amount\": 9200,\n  \"currency\": \"INR\",\n  \"counterpartyCountry\": \"IN\",\n  \"channel\": \"BRANCH\",\n  \"txnTimestamp\": \"{{demoDate}}T12:00:00Z\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.alerts && body.alerts.length) {",
              "    pm.collectionVariables.set('alertRef', body.alerts[0].alertRef);",
              "    console.log('captured alertRef', body.alerts[0].alertRef);",
              "}",
              "pm.test('alert raised', () => pm.expect(body.alerts.length).to.be.above(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Deposit 4 -> same alert updated (dedup)",
      "request": {
        "method": "POST",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{adminUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{adminPassword}}",
