        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "transactions"
          ]
        },
        "description": "First sub-threshold deposit. Returns \"alerts\": [] - one transaction is not a pattern.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"txnRef\": \"DEMO_1_{{runId}}\",\n  \"accountRef\": \"ACC_000001\",\n  \"direction\": \"CREDIT\",\n  \"txnType\": \"CASH_DEPOSIT\",\n  \"amount\": 9500,\n  \"currency\": \"INR\",\n  \"counterpartyCountry\": \"IN\",\n  \"channel\": \"BRANCH\",\n  \"txnTimestamp\": \"{{demoDate}}T06:00:00Z\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
