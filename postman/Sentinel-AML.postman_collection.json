              "value": "{{adminPassword}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/ingestion/customers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "ingestion",
            "customers"
          ]
        },
        "description": "Customers must load before accounts: account.customer_id is a foreign key.\n\nBody tab -> form-data -> key 'file' (type File) -> select customers.csv",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "/Users/tusharpruthi/Downloads/BlrAzenioJavahackathon/customers.csv"
            }
          ]
        }
      }
    },
    {
      "name": "03 - Bulk load accounts (CSV)",
