        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('caseRef', body.caseRef);",
              "console.log('captured caseRef', body.caseRef);",
              "pm.test('case opened', () => pm.expect(body.status).to.eql('OPEN'));"
            ]
          }
        }
      ]
